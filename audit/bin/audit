#!/usr/bin/env python3
"""
代码审计工具 - CLI 入口

使用 Click 框架构建命令行接口
"""

import sys
import os

# 添加项目根目录到 Python 路径
# audit/bin/audit -> audit -> org-repo-util
project_root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, project_root)

import click
from typing import Optional
from pathlib import Path

from audit.core.config_manager import ConfigManager
from audit.core.repo_scanner import RepoScanner
from audit.core.language_detector import LanguageDetector
from audit.core.file_collector import FileCollector
from audit.core.tool_installer import ToolInstaller
from audit.core.result_aggregator import ResultAggregator
from audit.core.report_storage import ReportStorage
from audit.core.index_generator import IndexGenerator
from audit.analyzers.registry import AnalyzerRegistry
from audit.reporters.json_reporter import JsonReporter
from audit.reporters.html_reporter import HtmlReporter
from audit.reporters.console_reporter import ConsoleReporter


@click.group()
@click.version_option(version="1.0.0", prog_name="audit")
@click.option("--verbose", "-v", is_flag=True, help="详细输出")
@click.option("--debug", is_flag=True, help="调试模式")
@click.pass_context
def cli(ctx, verbose: bool, debug: bool):
    """代码审计工具 - 静态代码分析"""
    ctx.ensure_object(dict)
    ctx.obj["verbose"] = verbose
    ctx.obj["debug"] = debug

    if debug:
        import logging
        logging.basicConfig(level=logging.DEBUG)


@cli.command()
@click.argument("repo_path", type=click.Path(exists=True))
@click.option("--format", "-f", "output_format",
              type=click.Choice(["json", "html", "console"]),
              default="console", help="输出格式")
@click.option("--output", "-o", type=click.Path(), help="输出文件路径")
@click.option("--branch", "-b", help="指定分支/tag/commit")
@click.option("--incremental", "-i", is_flag=True, help="增量审计")
@click.option("--language", "-l", help="只审计指定语言")
@click.option("--timeout", type=int, default=600, help="超时时间（秒）")
@click.option("--save", "-s", is_flag=True, help="保存报告到 reports/ 目录")
@click.option("--skip-dependency-scan", is_flag=True, help="跳过依赖漏洞扫描")
@click.pass_context
def repo(ctx, repo_path: str, output_format: str, output: Optional[str],
         branch: Optional[str], incremental: bool, language: Optional[str],
         timeout: int, save: bool, skip_dependency_scan: bool):
    """审计单个仓库"""
    from audit.core.auditor import Auditor
    from audit.core.audit_logger import init_audit_logger, close_audit_logger
    from datetime import datetime

    click.echo(f"🔍 审计仓库: {repo_path}")

    # 确定日志文件路径
    log_file = None
    if save:
        # 如果保存报告，日志文件保存在报告目录
        from pathlib import Path
        repo_name = Path(repo_path).name
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        report_dir = Path("reports") / "augmn" / repo_name / timestamp
        report_dir.mkdir(parents=True, exist_ok=True)
        log_file = str(report_dir / "report.log")

    # 初始化审计日志记录器
    audit_logger = init_audit_logger(log_file=log_file, verbose=ctx.obj["verbose"])

    try:
        auditor = Auditor(
            repo_path=repo_path,
            branch=branch,
            incremental=incremental,
            language_filter=language,
            timeout=timeout,
            verbose=ctx.obj["verbose"],
            skip_dependency_scan=skip_dependency_scan
        )

        result = auditor.audit()

        # 生成报告
        if output_format == "json":
            reporter = JsonReporter()
            reporter.generate([result], output or "report.json")
            click.echo(f"✅ JSON 报告已生成: {output or 'report.json'}")
        elif output_format == "html":
            reporter = HtmlReporter()
            reporter.generate([result], output or "report.html")
            click.echo(f"✅ HTML 报告已生成: {output or 'report.html'}")
        else:
            reporter = ConsoleReporter()
            reporter.generate([result])

        # 保存报告
        if save:
            _save_report(repo_path, [result])
            if log_file:
                click.echo(f"📋 审计日志已保存: {log_file}")

    except Exception as e:
        click.echo(f"❌ 审计失败: {e}", err=True)
        if ctx.obj["debug"]:
            import traceback
            traceback.print_exc()
        sys.exit(1)
    finally:
        # 关闭审计日志记录器
        close_audit_logger()


@cli.command()
@click.argument("org_name")
@click.option("--format", "-f", "output_format",
              type=click.Choice(["json", "html", "console"]),
              default="console", help="输出格式")
@click.option("--output", "-o", type=click.Path(), help="输出目录")
@click.option("--parallel", "-j", type=int, default=1, help="并行数量")
@click.option("--pattern", "-p", help="仓库名过滤模式")
@click.option("--skip-archived", is_flag=True, help="跳过 archived 仓库")
@click.option("--language", "-l", help="只审计指定语言")
@click.option("--timeout", type=int, default=600, help="单仓库超时（秒）")
@click.option("--incremental", "-i", is_flag=True, help="增量审计")
@click.option("--save", "-s", is_flag=True, help="保存报告到 reports/ 目录")
@click.option("--skip-dependency-scan", is_flag=True, help="跳过依赖漏洞扫描")
@click.pass_context
def org(ctx, org_name: str, output_format: str, output: Optional[str],
        parallel: int, pattern: Optional[str], skip_archived: bool,
        language: Optional[str], timeout: int, incremental: bool, save: bool,
        skip_dependency_scan: bool):
    """审计组织下所有仓库"""
    from audit.core.batch_auditor import BatchAuditor

    click.echo(f"🔍 审计组织: {org_name}")

    try:
        auditor = BatchAuditor(
            org_name=org_name,
            pattern=pattern,
            skip_archived=skip_archived,
            language_filter=language,
            parallel=parallel,
            timeout=timeout,
            verbose=ctx.obj["verbose"],
            incremental=incremental,
            skip_dependency_scan=skip_dependency_scan
        )

        results = auditor.audit()

        # 聚合结果
        aggregator = ResultAggregator()
        agg_result = aggregator.aggregate(results)

        # 生成报告
        if output_format == "json":
            reporter = JsonReporter()
            reporter.generate(results, output or "report.json")
            click.echo(f"✅ JSON 报告已生成: {output or 'report.json'}")
        elif output_format == "html":
            reporter = HtmlReporter()
            reporter.generate(results, output or "report.html")
            click.echo(f"✅ HTML 报告已生成: {output or 'report.html'}")
        else:
            reporter = ConsoleReporter()
            reporter.generate(results)

        # 保存报告
        if save:
            _save_org_report(org_name, results)

    except Exception as e:
        click.echo(f"❌ 审计失败: {e}", err=True)
        if ctx.obj["debug"]:
            import traceback
            traceback.print_exc()
        sys.exit(1)


def _save_report(repo_path_arg: str, results):
    """保存单个仓库报告"""
    from audit.core.report_storage import ReportStorage

    storage = ReportStorage()

    # 重建报告数据
    report_data = {
        'metadata': {
            'generated_at': __import__('datetime').datetime.now().isoformat(),
            'total_repos': len(results),
        },
        'results': [r.to_dict() for r in results],
    }

    # 从命令行参数解析 org/repo
    # 支持格式: repos/<org>/<repo>, <org>/<repo>, <repo>
    parts = Path(repo_path_arg).parts
    if len(parts) >= 3 and parts[0] == "repos":
        org, repo = parts[1], parts[2]
    elif len(parts) >= 2:
        org, repo = parts[-2], parts[-1]
    else:
        org, repo = "unknown", results[0].repo

    saved = storage.save_report(org, repo, report_data)
    click.echo(f"✅ 报告已保存: {saved['json']}")

    # 自动更新索引页
    _update_index()


def _save_org_report(org_name: str, results):
    """保存组织报告"""
    from audit.core.report_storage import ReportStorage
    from audit.reporters.json_reporter import JsonReporter

    storage = ReportStorage()

    # 按仓库分组
    for result in results:
        report_data = {
            'metadata': {
                'generated_at': __import__('datetime').datetime.now().isoformat(),
                'total_repos': 1,
            },
            'results': [result.to_dict()],
        }

        # 解析仓库路径
        parts = result.repo.split('/')
        if len(parts) >= 2:
            org, repo = parts[-2], parts[-1]
        else:
            org, repo = org_name, result.repo

        saved = storage.save_report(org, repo, report_data)
        click.echo(f"  ✅ {repo}: {saved['json']}")

    # 自动更新索引页
    _update_index()


def _update_index():
    """更新报告索引页"""
    try:
        from audit.core.index_generator import IndexGenerator
        generator = IndexGenerator()
        generator.generate_index()
    except Exception as e:
        # 索引生成失败不应影响报告保存
        import logging
        logging.getLogger(__name__).warning(f"更新索引页失败: {e}")


@cli.group()
def tools():
    """工具管理命令"""
    pass


@tools.command("install")
@click.option("--force", is_flag=True, help="强制重新安装")
def tools_install(force: bool):
    """安装所有分析工具"""
    installer = ToolInstaller()
    tools_to_install = ["eslint", "golangci-lint", "dotnet-format"]

    click.echo("📦 安装分析工具...")
    success_count = 0
    for tool in tools_to_install:
        # 检查是否已安装
        if not force and installer.is_installed(tool):
            version = installer.get_version(tool)
            click.echo(f"  ✅ {tool}: 已安装 ({version})")
            success_count += 1
            continue

        click.echo(f"  ⏳ 安装 {tool}...")
        success = installer.install(tool)
        if success:
            version = installer.get_version(tool)
            click.echo(f"  ✅ {tool}: 安装成功 ({version})")
            success_count += 1
        else:
            click.echo(f"  ❌ {tool}: 安装失败")

    click.echo(f"\n安装完成: {success_count}/{len(tools_to_install)}")


@tools.command("list")
def tools_list():
    """列出已安装的工具"""
    installer = ToolInstaller()

    click.echo("🔧 已安装的工具:")
    tools_to_check = ["eslint", "golangci-lint", "dotnet-format"]
    for tool in tools_to_check:
        if installer.is_installed(tool):
            version = installer.get_version(tool)
            click.echo(f"  ✅ {tool}: {version}")
        else:
            click.echo(f"  ❌ {tool}: 未安装")


@cli.group()
def config():
    """配置管理命令"""
    pass


@config.command("show")
def config_show():
    """显示当前配置"""
    config_manager = ConfigManager()
    import yaml

    click.echo("📋 当前配置:")
    click.echo(yaml.dump(config_manager.merged_config, default_flow_style=False))


@config.command("validate")
@click.option("--file", "-f", "file_path", type=click.Path(exists=True), help="配置文件路径")
@click.option("--repo", "-r", type=click.Path(exists=True), help="仓库路径")
def config_validate(file_path: Optional[str], repo: Optional[str]):
    """验证配置文件"""
    import yaml

    config_manager = ConfigManager()

    if file_path:
        click.echo(f"🔍 验证配置文件: {file_path}")
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                config = yaml.safe_load(f)

            # 基础验证
            if not isinstance(config, dict):
                click.echo("❌ 配置文件格式错误: 必须是 YAML 字典")
                return

            # 检查必要字段
            if 'version' not in config:
                click.echo("⚠️  警告: 缺少 'version' 字段")

            # 检查语言配置
            if 'languages' in config:
                for lang, lang_config in config['languages'].items():
                    if not isinstance(lang_config, dict):
                        click.echo(f"❌ 语言 {lang} 配置格式错误")
                        return
                    if 'enabled' not in lang_config:
                        click.echo(f"⚠️  警告: 语言 {lang} 缺少 'enabled' 字段")

            click.echo("✅ 配置文件格式正确")

        except yaml.YAMLError as e:
            click.echo(f"❌ YAML 解析错误: {e}")
        except Exception as e:
            click.echo(f"❌ 验证失败: {e}")

    elif repo:
        click.echo(f"🔍 验证仓库配置: {repo}")
        try:
            config_manager.load_repo_config(repo)
            if config_manager.repo_config:
                click.echo("✅ 仓库配置文件格式正确")
                click.echo(f"  配置项: {list(config_manager.repo_config.keys())}")
            else:
                click.echo("ℹ️  仓库没有配置文件，使用全局配置")
        except Exception as e:
            click.echo(f"❌ 验证失败: {e}")

    else:
        click.echo("🔍 验证全局配置...")
        if config_manager.validate_config(config_manager.global_config):
            click.echo("✅ 全局配置格式正确")
            click.echo(f"  配置项: {list(config_manager.global_config.keys())}")
        else:
            click.echo("❌ 全局配置格式错误")


@cli.group()
def reports():
    """报告管理命令"""
    pass


@reports.command("list")
@click.option("--org", "-o", help="组织名过滤")
@click.option("--repo", "-r", help="仓库名过滤")
def reports_list(org: Optional[str], repo: Optional[str]):
    """列出历史报告"""
    storage = ReportStorage()
    report_list = storage.list_reports(org=org, repo=repo)

    if not report_list:
        click.echo("📭 暂无历史报告")
        return

    from rich.console import Console
    from rich.table import Table
    from rich import box

    console = Console()
    table = Table(title="历史审计报告", box=box.ROUNDED)
    table.add_column("组织", style="cyan")
    table.add_column("仓库", style="magenta")
    table.add_column("时间戳", style="green")
    table.add_column("路径", style="dim")

    for r in report_list:
        table.add_row(r['org'], r['repo'], r['timestamp'], r['path'])

    console.print(table)


@reports.command("clean")
@click.option("--days", "-d", type=int, default=30, help="保留天数")
def reports_clean(days: int):
    """清理旧报告"""
    storage = ReportStorage()
    click.echo(f"🧹 清理 {days} 天前的报告...")
    cleaned = storage.clean_old_reports(days=days)
    click.echo(f"  ✅ 清理了 {cleaned} 个报告")


@reports.command("index")
def reports_index():
    """生成/更新报告索引页"""
    generator = IndexGenerator()
    click.echo("📊 生成报告索引页...")
    output_path = generator.generate_index()
    if output_path:
        click.echo(f"  ✅ 索引页已生成: {output_path}")
    else:
        click.echo("  ⚠️  未生成索引页（没有找到报告）")


