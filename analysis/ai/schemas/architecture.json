{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai.architecture output",
  "type": "object",
  "required": ["overview", "components", "issues", "architecture_diagram_mermaid", "score", "score_reasons"],
  "properties": {
    "overview": {"type": "string", "minLength": 20},
    "entry_points": {"type": "array"},
    "layers": {"type": "array"},
    "components": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["name", "responsibility"],
                "properties": {"name": {"type": "string"}, "responsibility": {"type": "string"}, "evidence": {"type": "array"}}}
    },
    "patterns": {"type": "array"},
    "dependency_issues": {"type": "array"},
    "architecture_diagram_mermaid": {"type": "string", "minLength": 10},
    "doc_assessment": {"type": "object"},
    "issues": {
      "type": "array",
      "items": {"type": "object", "required": ["severity", "title"],
                "properties": {"severity": {"enum": ["high", "medium", "low"]}, "title": {"type": "string"}, "detail": {"type": "string"}, "evidence": {"type": "array"}, "suggestion": {"type": "string"}}}
    },
    "suggestions": {"type": "array", "items": {"type": "string"}},
    "score": {"type": "number", "minimum": 0, "maximum": 100},
    "score_reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
